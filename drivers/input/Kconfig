config INPUT_IQS9151_CURSOR_REPORT_INTERVAL_MS
    int "IQS9151 cursor report interval (ms)"
    range 0 100
    default 0
    help
      Minimum interval between REL_X/REL_Y reports for single-finger
      cursor movement (driver-side). Movement within the interval is
      accumulated and sent as one report. 0 sends a report for every
      frame. Try 16 to 25 when reports pile up on a BLE link.

config INPUT_IQS9151_SCROLL_REPORT_INTERVAL_MS
    int "IQS9151 scroll report interval (ms)"
    range 0 100
    default 0
    help
      Minimum interval between WHEEL/HWHEEL reports for two-finger
      scroll (driver-side). Scroll within the interval is accumulated
      and sent as one report. 0 sends a report for every frame. Try 16
      to 25 when reports pile up on a BLE link.

config INPUT_IQS9151_THREAD_PRIORITY
    int "IQS9151 dedicated work queue thread priority"
    default 2
    help
      Priority of the driver's dedicated work queue thread, which runs
      frame processing off the system work queue. Keep it lower priority
      (higher numeric value) than the system work queue (-1) and the ZMK
      input thread (0), but higher priority (lower numeric value) than
      the BLE/split TX thread (5).

config INPUT_IQS9151_THREAD_STACK_SIZE
    int "IQS9151 dedicated work queue thread stack size"
    default 3072
    help
      Stack size in bytes for the driver's dedicated work queue thread.

config INPUT_IQS9151_HOLD_COMMS_WINDOW
    bool "Hold the IQS9151 communication window until explicitly terminated"
    default y
    help
      Set the Terminate Comms Window bit so the RDY window stays open until
      the driver writes the 0xEEEE terminate command after reading a frame.
      Without this the window closes before the driver thread reads and every
      read clock-stretches until the next sensing cycle (one cycle of extra
      latency, up to hundreds of ms in low-power modes).

config INPUT_IQS9151_SHELL
    bool "IQS9151 tp shell command"
    depends on SHELL
    default n
    help
      Add the "tp" shell command to inspect and change gesture and
      sensitivity parameters at runtime (used by tools/tp-tuner).

config INPUT_IQS9151_SETTINGS
    bool "IQS9151 runtime parameter persistence"
    depends on SETTINGS
    default y if SETTINGS
    help
      Store the runtime parameters with the Zephyr settings subsystem
      under "iqs9151/params" and apply them on settings_load(). Saving
      is explicit ("tp save"); "tp reset" also deletes the saved blob.

config INPUT_IQS9151_TEST
    bool "IQS9151 test hooks"
    depends on ZTEST
    default n
    help
      Expose IQS9151 internal test APIs and event hooks for ZTEST.

endif
